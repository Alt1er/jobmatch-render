{
  "name": "jobmatch-backend",
  "version": "1.1.0",
  "description": "Веб-платформа інтелектуального зіставлення вакансій і резюме — бекенд",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "embedded-postgres": "17.11.0-beta.19"
  }
}
