# Усі налаштування необов'язкові: без цього файлу проєкт працює «з коробки»
# (вбудований PostgreSQL, демо-дані, порт 4000).
# Щоб змінити щось — скопіюйте цей файл у .env і розкоментуйте потрібні рядки.

PORT=4000

# Власна база даних. Якщо рядок закоментовано — сервер сам запускає вбудований PostgreSQL
# (файли бази лежать у backend/.pgdata, порт 54329).
# DATABASE_URL=postgres://jobmatch:jobmatch@localhost:5432/jobmatch

# Додавати демо-дані при першому запуску (для вбудованої БД — true за замовчуванням,
# для власної — вимкнено; тоді використовуйте npm run db:seed)
# AUTO_SEED=true

# ОБОВ'ЯЗКОВО змініть перед публікацією в інтернет
JWT_SECRET=змініть-цей-секрет-на-довгий-випадковий-рядок
JWT_EXPIRES_IN=7d

# Звідки дозволені запити (фронтенд у режимі розробки)
CORS_ORIGIN=http://localhost:5173

# Максимальний розмір резюме, МБ
MAX_UPLOAD_MB=5
